#! /usr/bin/env bash

VERBOSE=""
DEBUG=""

ELISP='false'
ELISP='false'
DIFF='false'
MERGE='false'
NO_INIT='false'

system_name=$(uname)

function verbosity {
  if [[ "$VERBOSE" == 'true' ]]
  then
    echo >/dev/stderr "run-emacs: $*"
  fi
}

function print_paths {
  verbosity "emacs = \"${emacs}\" emacs_launch = \"${emacs_launch}\" emacsclient = \"${emacsclient}\""
}

function verify_emacs {
  test -e $emacsclient || return 1
  test -e $emacs_bin || return 1

  return 0
}

#
# my user local build from source
#
 
function find_tools_emacs {
  # dummy fields
  emacs="$HOME/tools/local/"

  # set fields
  emacs_launch="${emacs}bin/emacs"
  emacs_bin="${emacs}bin/emacs"
  emacsclient="${emacs}bin/emacsclient"

  print_paths

  verify_emacs || return 1

  return 0
}

function find_default_emacs {
  look="/usr/local/bin/"

  if [[ -x "${look}emacs" ]]
  then
    emacs_launch="${look}emacs"
    emacs_bin="${look}emacs"
    emacsclient="${look}emacsclient"

    emacs="${look}emacs"
  fi
    
  if verify_emacs
  then
    return 0
  fi

  look="/usr/bin/"

  if [[ -x "${look}emacs" ]]
  then
    emacs_launch="${look}emacs"
    emacs_bin="${look}emacs"
    emacsclient="${look}emacsclient"

    emacs="${look}emacs"
  fi

  if verify_emacs
  then
    return 0
  fi

  return 1
}

function find_macos_emacs {
  # Emacs.app from FSF distributed or source build
  emacs="/Applications/Emacs.app/Contents/MacOS"

  emacs_launch="/Applications/Emacs.app/Contents/MacOS/Emacs"
  emacs_bin="${emacs}/bin/"
  emacsclient="${emacs_bin}emacsclient"

  if verify_emacs
  then
     return 0
  fi    

  emacs="/opt/homebrew/Cellar"
  found=`find $emacs -name Emacs.app -print`

  if [[ -n $found ]]
  then
    emacs=$found
    emacs_base=`dirname $emacs`

    emacs_launch="${emacs}/Contents/MacOS/Emacs"

    emacs_bin="${emacs_base}/bin/"
    emacsclient="${emacs_bin}emacsclient"

    if verify_emacs $emacs
    then
      return 0
    fi
  fi

  return 1
}

arguments=()
code=""

function emacs_invoke {
  verbosity "arguments given" ${arguments[0]} $ELISP

  if [[ "$VERBOSE" == 'true' ]]
  then
    print_paths

    for arg in "${arguments[@]}"
    do
      echo >/dev/stderr "run-emacs: argument> $arg"
    done
  fi

  if [[ "$NO_INIT" == 'true' ]]
  then
    exec $emacs_launch -q
  fi

  if [[ "$ELISP" == 'true' ]]
  then
    verbosity "executing code = " $code
    exec $emacsclient -e "$code"
  fi

  if [[ "$DIFF" == 'true' ]]
  then
    if [[ ${#arguments[@]} -lt 2 ]]
    then
      echo "run-emacs: diff requires at least two files: upstream, and local" >/dev/stderr 2>&1
      exit 1
    fi

    local_file=${arguments[0]}
    upstream_file=${arguments[1]}

    # recusive edit and the progn form makes the elisp code eval wait
    verbosity "diff of local:$local_file and upstream:$upstream_file"

    exec $emacsclient -e '(progn (grail-diff-elisp "$LOCAL" "$REMOTE" (recursive-edit)))'
  fi

  if [[ $# -gt 0 ]]
  then
    verbosity "remaining arguments - exec emacsclient: ${arguments[@]}"
    exec $emacsclient $@
  fi

  $emacs_launch >/dev/null &
  launch_code=$?

  if [[ $launch_code -gt 0 ]]
  then
    return $launch_code
    disown %1
  fi

  return 0
}

for arg in $@
do
  case $arg in
    "-v")
      VERBOSE='true'
      continue
    ;;
    ":")
      ELISP='true'
      continue
    ;;
    "-e")
      ELISP='true'
      continue
    ;;
    "-q")
      NO_INIT='true'
      continue
    ;;
    "^")
     DIFF='true'
     continue
    ;;
    "+")
     MERGE='true'
     continue
    ;;
  esac

  if [[ "$ELISP" == 'true' ]]
  then
    code="${code} ${arg}"

    verbosity "code> $code"
    continue
  fi

  verbosity "shell arg> $arg"
  arguments+=($arg)
done

case $system_name in
  "Darwin")
    if find_macos_emacs
    then
      verbosity "found Emacs on Darwin: " $emacs
    fi
  ;;
  *)
    if find_tools_emacs
    then
      verbosity "found Emacs in: tools"

      emacs_invoke
      exit 0
    fi

    if find_default_emacs
    then
      verbosity "run-emacs: found Emacs in: generic"
    fi
  ;;
esac

emacs_invoke
exit 0

