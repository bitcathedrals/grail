#! /usr/bin/env bash

VERBOSE=""
DEBUG=""

system_name=$(uname)

function verify_emacs {
    if [[ -f $emacsclient ]]
    then
        return 0
    fi

    if [[ -f $emacs_bin ]]
    then
        return 0
    fi

    echo >/dev/stderr "run-emacs: $emacs doesnt set usable paths: $emacsclient $emacs_bin" 
    exit 1
}

function find_macos_emacs {
    # Emacs.app from FSF distributed or source build
    emacs="/Applications/Emacs.app/Contents/MacOS"

    emacs_launch="/Applications/Emacs.app/Contents/MacOS/Emacs"
    emacs_bin="${emacs}/bin/"
    emacsclient="${emacs_bin}emacsclient"

    if verify_emacs
    then
       return 0
    fi    

    emacs="/opt/homebrew/Cellar"
    found=`find $emacs -name Emacs.app -print`

    if [[ -n $found ]]
    then
        emacs=$found
        emacs_base=`dirname $emacs`

        emacs_launch="${emacs}/Contents/MacOS/Emacs"

        emacs_bin="${emacs_base}/bin/"
        emacsclient="${emacs_bin}emacsclient"

        if verify_emacs $emacs
        then
            return 0
        fi
    fi

    return 1
}

function emacs_invoke {
  if [[ -n $VERBOSE ]]
  then
    echo >/dev/stderr "run-emacs (verbose): emacs = \"${emacs}\" emacslaunch = \"${emacs_launch}\" emacsclient = \"${emacsclient}\""
  fi

  if [[ -n $DEBUG ]]
  then
    echo >/dev/stderr "run-emacs (debug): (skip) emacs/emacslient ${@}"
    exit 1
  fi

  if [[ $# -gt 0 ]]
  then
    $emacsclient $@
    exit $?
  fi

  $emacs_launch >/dev/null &
  launch_code=$?

  if [[ $launch_code -ne 0 ]]
  then
    return $launch_code
  fi

  disown %1
  return 0
}

arguments=()

for arg in $@
do
  case $arg in
    "-v")
      VERBOSE='true'

      if [[ -n $VERBOSE ]]
      then
         echo >/dev/stderr "switch> -v (verbose)"
      fi
    ;;
    "-d")
      DEBUG='true'

      if [[ -n $VERBOSE ]]
      then
         echo >/dev/stderr "switch> -d (debug)"
      fi
    ;;
    *)
      if [[ -n $VERBOSE ]]
      then
         echo >/dev/stderr "arg> $arg"
      fi

      arguments+=($arg)
    ;;
  esac
done

case $system_name in
  "Darwin")
    if find_macos_emacs
    then
      if [[ -n $VERBOSE ]]
      then
        echo >/dev/stderr "run-emacs: found Emacs on Darwin: $emacs"
      fi
    fi
  ;;
esac

emacs_invoke ${arguments[@]}

