#! /usr/bin/env bash

VERBOSE=""
DEBUG=""

system_name=$(uname)

function verbosity {
  if [[ "$VERBOSE" == 'true' ]]
  then
    echo >/dev/stderr "run-emacs: $*"
  fi
}

function print_paths {
  verbosity "emacs = \"${emacs}\" emacs_launch = \"${emacs_launch}\" emacsclient = \"${emacsclient}\""
}

function verify_emacs {
  test -e $emacsclient || return 1
  test -e $emacs_bin || return 1

  return 0
}

#
# my user local build from source
#
 
function find_tools_emacs {
  # dummy fields
  emacs="$HOME/tools/local/"

  # set fields
  emacs_launch="${emacs}bin/emacs"
  emacs_bin="${emacs}bin/emacs"
  emacsclient="${emacs}bin/emacsclient"

  print_paths

  verify_emacs || return 1

  return 0
}

function find_default_emacs {
  # generic find emacs - a little wasteful, but it couples to the rest of  the script
  emacs="/usr"
  emacs_launch="${emacs}/bin/emacs"
  emacs_bin="${emacs}/bin/emacs"
  emacsclient="${emacs}/emacsclient"

  if verify_emacs
  then
    return 0
  else
    return 1
  fi
}

function find_macos_emacs {
  # Emacs.app from FSF distributed or source build
  emacs="/Applications/Emacs.app/Contents/MacOS"

  emacs_launch="/Applications/Emacs.app/Contents/MacOS/Emacs"
  emacs_bin="${emacs}/bin/"
  emacsclient="${emacs_bin}emacsclient"

  if verify_emacs
  then
     return 0
  fi    

  emacs="/opt/homebrew/Cellar"
  found=`find $emacs -name Emacs.app -print`

  if [[ -n $found ]]
  then
    emacs=$found
    emacs_base=`dirname $emacs`

    emacs_launch="${emacs}/Contents/MacOS/Emacs"

    emacs_bin="${emacs_base}/bin/"
    emacsclient="${emacs_bin}emacsclient"

    if verify_emacs $emacs
    then
      return 0
    fi
  fi

  return 1
}

arguments=()
code=""

function emacs_invoke {
  verbosity "arguments given" ${arguments[0]} $ELISP

  if [[ "$VERBOSE" == 'true' ]]
  then
    print_paths

    for arg in "${arguments[@]}"
    do
      echo >/dev/stderr "run-emacs: argument> $arg"
    done
  fi

  if [[ "$ELISP" == 'true' ]]
  then
    verbosity "executing code = " $code
    exec $emacsclient -e "$code"
  fi

  if [[ "$DIFF" == 'true' ]]
  then
    # assign arguments to positional
    set -- "${arguments[@]}"

    local_file=$1
    shift

    upstream_file=$1
    shift

    ancestor_file=$1

    if [[ -n $ancestor_file ]]
    then
      verbosity "diff of local: $local_file and upstream: $upstream_file and $ancestor_file"
      verbosity exec $emacsclient -n -e "(grail-diff-ancestor-elisp \"$local_file\" \"$upstream_file\" \"$ancestor_file\")"

      exec $emacsclient -n -e "(grail-diff-ancestor-elisp \"$local_file\" \"$upstream_file\" \"$ancestor_file\")"
    else
      verbosity "diff of local: $local_file and upstream: $upstream_file"
      verbosity exec $emacsclient -n -e "(grail-diff-elisp \"$local_file\" \"$upstream_file\")"

      exec $emacsclient -n -e "(grail-diff-elisp \"$local_file\" \"$upstream_file\")"
    fi
  fi

  set -- "${arguments[@]}"

  if [[ $# -gt 0 ]]
  then
    verbosity "remaining arguments - exec emacsclient: ${arguments[@]}"
    exec $emacsclient $@
  fi

  $emacs_launch >/dev/null &
  launch_code=$?

  if [[ $launch_code -gt 0 ]]
  then
    return $launch_code
  fi

  disown %1
  return 0
}

for arg in $@
do
  case $arg in
    "-vv")
      VERBOSE='true'
      continue
    ;;
    ":")
      ELISP='true'
      continue
    ;;
    "-e")
      ELISP='true'
      continue
    ;;
    "^")
     DIFF='true'
     continue
    ;;
  esac

  if [[ "$ELISP" == 'true' ]]
  then
    code="${code} ${arg}"

    verbosity "code> $code"
    continue
  fi

  verbosity "shell arg> $arg"
  arguments+=($arg)
done

case $system_name in
  "Darwin")
    if find_macos_emacs
    then
      verbosity "found Emacs on Darwin: " $emacs
    fi
  ;;
  *)
    if find_tools_emacs
    then
      verbosity "found Emacs in: tools"

      emacs_invoke
      exit 0
    fi

    if find_default_emacs
    then
      verbosity "run-emacs: found Emacs in: generic"
    fi
  ;;
esac

emacs_invoke
exit 0

